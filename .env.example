# 이 파일은 서버(server/)가 실제로 사용하는 환경변수 목록입니다.
# Docker Manager 배포 시 이 파일의 변수가 반영됩니다. 로컬 실행은 .env로 복사해 값을 바꾸세요.

# 서버 설정 (Docker Manager Node.js 유형은 0.0.0.0:3000)
PORT=3000
HOST=0.0.0.0

# MongoDB 연결 (필수). Docker Manager 배포 기준: docker-manager-net 안의 컨테이너 mongodb (인증 없음).
# MONGO_URL이라는 이름으로 넣어도 됩니다. 로컬에서 실행할 때는 .env에 mongodb://localhost:27017/<DB 이름>
MONGODB_URI=mongodb://mongodb:27017/cc_usage
# 사용할 DB 이름. 비우면 MONGODB_URI 경로의 DB 이름, 그것도 없으면 cc_usage
MONGODB_DB=cc_usage

# 업로드 인증 토큰. 설정하면 클라이언트가 Authorization: Bearer <토큰>을 보내야 합니다.
# 운영 환경에서는 반드시 설정하세요 (클라이언트: cc-usage setup --token, CCUSAGE_TOKEN).
INGEST_TOKEN=

# 클라이언트가 접속할 서버 주소 (선택). 대시보드의 "클라이언트 설정 방법" 예시 명령에 이 주소를 씁니다.
# 비우면 대시보드에 접속한 주소를 쓰고, 서버 컴퓨터에서 localhost로 열었을 때는 네트워크 주소를 자동으로 찾습니다.
# 예: https://tools.example.com/c/cc-usage
PUBLIC_URL=

# 엑셀 내보내기의 시각 표시 시간대 (컨테이너 기본 시간대는 보통 UTC)
REPORT_TIMEZONE=Asia/Seoul

# 대시보드 로그인 (Microsoft Entra ID, 회사 계정). 두 값을 모두 넣으면 로그인이 켜지고, 둘 다 비우면 로그인 없이
# 열립니다(로컬 실행용). 비밀값이 아닙니다(로그인 주소에 그대로 보이는 값이며, client secret은 쓰지 않습니다).
# 앱 등록은 이 대시보드 전용으로 만드세요. 다른 사내 앱과 같은 ID를 쓰면 그 앱의 토큰이 여기서도 통과합니다.
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
# 화면(SPA)용 앱이 따로 있을 때만. 비우면 ENTRA_API_CLIENT_ID를 씁니다.
ENTRA_SPA_CLIENT_ID=
# 토큰에 있어야 하는 범위 이름. 비우면 access_as_user
ENTRA_REQUIRED_SCOPE=

# 전원의 사용량을 볼 수 있는 관리자 이메일(쉼표로 구분). 그 밖의 사람은 로그인해도 본인 사용량만 봅니다.
ADMIN_EMAILS=jyso@aircode.com
# 엑셀 다운로드를 할 수 있는 이메일(쉼표로 구분). 관리자여도 여기 없으면 버튼이 안 보입니다. 비우면 jyso@aircode.com 만.
EXPORT_EMAILS=jyso@aircode.com
# 회사는 Claude Code만 지원합니다. Codex(GPT) 사용량은 이 사용자 ID(쉼표로 구분)만 저장·표시하고, 그 밖의 사람 것은 받을 때 버리고
# 서버가 켜질 때 이미 저장된 것도 지웁니다. 비우면 shhong@aircode.com 만.
CODEX_EMAILS=shhong@aircode.com
# 로그인을 허용할 이메일 도메인(쉼표로 구분). 비우면 테넌트의 모든 계정(게스트 포함)이 로그인할 수 있습니다.
ALLOWED_EMAIL_DOMAINS=aircode.com
