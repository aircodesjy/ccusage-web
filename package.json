{
  "name": "cc-usage",
  "version": "1.0.0",
  "private": true,
  "description": "Collects per-user Claude Code usage reports (from the cc-usage client) and shows team statistics",
  "type": "module",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "seed:sample": "node server/scripts/seed-sample.js",
    "seed:clean": "node server/scripts/seed-sample.js --clean"
  },
  "dependencies": {
    "@azure/msal-browser": "^2.38.4",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "mongodb": "^7.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
